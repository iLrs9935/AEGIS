# Public-source allowlist. Private local files stay outside Git by default.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/core/
!/functions/
!/nodes/
!/ui/
!/tests/
!/scripts/
!/tools/
!/images/
!/examples/
!/docs/
!/main.py
!/pyinstaller.py
!/AEGIS Command Terminal.spec
!/readme.md
!/README.zh-CN.md
!/LICENSE
!/AI_WORKFLOW_PROMPT.md
!/SECURITY.md
!/RELEASE_REVIEW.md
!/requirements.txt
!/requirements-build.txt
!/config.local.example.json

__pycache__/
*.py[cod]
.env
.env.*
*.local.*
!config.local.example.json
*.db
*.db-*
*.sqlite*
*.log
*.bak
*.tmp
*.pem
*.key
*.pfx
*.p12
*.exe
*.dll
*.lib
*.zip
.DS_Store

# Templates are the only public image assets.
/images/*
!/images/icons/
!/images/cdkey_process/
!/images/sdkdns/
!/images/鸣潮自运行/
